.paste-area {
  width: 100%;
  min-height: 320rpx;
  background: #fff8f9;
  border: 2rpx dashed #f0c4cf;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.or {
  text-align: center;
  color: var(--ink-soft);
  font-size: 24rpx;
  margin: 8rpx 0 24rpx;
}

.tip {
  margin-top: 28rpx;
  background: #fff7e6;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  font-size: 24rpx;
  color: #a0783c;
  line-height: 1.7;
}

.error {
  margin-top: 24rpx;
  color: #d64545;
  font-size: 26rpx;
  text-align: center;
}

.sender-list {
  margin-bottom: 8rpx;
}
.sender-row {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  background: #fff8f9;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}
.sender-row.active {
  border-color: var(--primary);
  background: #fff0f3;
}
.radio {
  color: var(--primary);
  font-size: 32rpx;
  margin-right: 20rpx;
}
.sender-info {
  flex: 1;
}
.sender-label {
  font-size: 30rpx;
  font-weight: 700;
}
.sender-count {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
}
.role-tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}
.role-tag.me {
  background: rgba(255, 95, 126, 0.15);
  color: var(--primary-deep);
}
.role-tag.friend {
  background: #f0f0f0;
  color: var(--ink-soft);
}
