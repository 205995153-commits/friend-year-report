.home {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.hero {
  padding: 40rpx 8rpx 48rpx;
  position: relative;
}
.badge {
  display: inline-block;
  background: rgba(255, 95, 126, 0.12);
  color: var(--primary-deep);
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.hero-title {
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1.25;
  color: #3d2129;
}
.hero-sub {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}
.hero-deco {
  margin-top: 24rpx;
  font-size: 44rpx;
  letter-spacing: 16rpx;
}

.mode-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 44rpx rgba(224, 67, 104, 0.09);
  transition: transform 0.15s ease;
}
.mode-card-hover {
  transform: scale(0.98);
}
.mode-icon {
  font-size: 60rpx;
  margin-right: 28rpx;
}
.mode-body {
  flex: 1;
}
.mode-title {
  font-size: 34rpx;
  font-weight: 800;
}
.mode-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}
.arrow {
  font-size: 48rpx;
  color: #e8c2cc;
  font-weight: 300;
}

.privacy {
  margin-top: auto;
  padding: 20rpx 8rpx 0;
  font-size: 22rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  text-align: center;
}
