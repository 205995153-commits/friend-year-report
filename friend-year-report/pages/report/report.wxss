.report {
  height: 100vh;
  width: 100%;
}
.swiper {
  height: 100vh;
}
.slide {
  height: 100vh;
  padding: 48rpx 40rpx 120rpx;
  box-sizing: border-box;
}

/* ============ 封面 ============ */
.cover {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 70vh;
  text-align: center;
}
.cover-badge {
  background: rgba(255, 95, 126, 0.12);
  color: var(--primary-deep);
  border-radius: 999rpx;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 40rpx;
}
.cover-names {
  font-size: 60rpx;
  font-weight: 900;
  color: #3d2129;
  line-height: 1.3;
}
.cover-range {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
}
.cover-emoji {
  font-size: 120rpx;
  margin-top: 60rpx;
  animation: float 2.6s ease-in-out infinite;
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}
.cover-hint {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #c9a6af;
}

/* ============ 通用 ============ */
.slide-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #3d2129;
  margin-bottom: 28rpx;
}
.card.inner {
  margin-bottom: 20rpx;
}
.verdict-line {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  color: #6b4a55;
  line-height: 1.6;
  box-shadow: 0 8rpx 30rpx rgba(224, 67, 104, 0.07);
  margin-bottom: 16rpx;
  text-align: center;
}

/* ============ 数字总览 ============ */
.big-grid {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.big-cell {
  flex: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 0;
  text-align: center;
  box-shadow: 0 12rpx 44rpx rgba(224, 67, 104, 0.09);
}
.big-num {
  font-size: 72rpx;
  font-weight: 900;
  color: var(--primary-deep);
  line-height: 1.1;
}
.big-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}
.ratio-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.ratio-name {
  width: 160rpx;
  font-size: 26rpx;
  font-weight: 700;
}
.ratio-bar {
  flex: 1;
  height: 28rpx;
  background: #f7eef0;
  border-radius: 999rpx;
  overflow: hidden;
}
.ratio-fill {
  height: 100%;
  border-radius: 999rpx;
}
.ratio-fill.me {
  background: linear-gradient(90deg, #ff9a76, #ff5f7e);
}
.ratio-fill.friend {
  background: linear-gradient(90deg, #6fc3ff, #4f8ef7);
}
.ratio-pct {
  width: 90rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--ink);
}

/* ============ 24h 柱状图 ============ */
.chart-bars {
  display: flex;
  align-items: flex-end;
  height: 340rpx;
  gap: 6rpx;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  height: 100%;
}
.bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, #ff8fa6, #ff5f7e);
  position: relative;
  min-height: 8rpx;
}
.bar-val {
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: var(--ink-soft);
  white-space: nowrap;
}
.bar-label {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: var(--ink-soft);
  min-height: 26rpx;
}

/* ============ 高频词云 ============ */
.word-cloud {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  min-height: 320rpx;
  padding: 36rpx 24rpx;
}
.word {
  color: #5b3a45;
  font-weight: 700;
  line-height: 1.2;
}

/* ============ 亲密瞬间 ============ */
.moment {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #faf0f2;
}
.moment:last-child {
  border-bottom: none;
}
.moment-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
}
.moment-label {
  font-size: 22rpx;
  color: var(--ink-soft);
}
.moment-text {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #4a2b33;
  font-weight: 600;
}

/* ============ 故事/专属词 ============ */
.story-emoji {
  font-size: 72rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.story-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #4a2b33;
  text-align: center;
}
.story-line {
  width: 60rpx;
  height: 4rpx;
  background: #f0c4cf;
  border-radius: 4rpx;
  margin: 32rpx auto;
}
.big-word {
  font-size: 88rpx;
  font-weight: 900;
  text-align: center;
  color: var(--primary-deep);
  padding: 30rpx 0;
}
.center-card {
  text-align: center;
  padding: 48rpx 32rpx;
}
.topic-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #3d2129;
  margin-top: 8rpx;
}

/* ============ 称号 ============ */
.award-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 44rpx rgba(224, 67, 104, 0.09);
}
.award-icon {
  font-size: 56rpx;
  margin-right: 26rpx;
}
.award-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #3d2129;
}
.award-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}

/* ============ 尾声 ============ */
.verdict-text {
  font-size: 30rpx;
  line-height: 2;
  color: #4a2b33;
}
.share-btn {
  margin-top: 20rpx;
  background: #fff;
  color: var(--primary-deep);
  border: 2rpx solid rgba(224, 67, 104, 0.35);
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 2.6;
}
.share-btn::after {
  border: none;
}
.btn-ghost {
  margin-top: 20rpx;
}

/* ============ 海报弹层 ============ */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 10, 20, 0.72);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.poster-img {
  width: 100%;
  border-radius: 20rpx;
  display: block;
}
.poster-actions {
  margin-top: 28rpx;
}
.poster-close {
  text-align: center;
  padding: 20rpx 0 4rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 640px;
  height: 1000px;
}
