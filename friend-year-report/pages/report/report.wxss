.report {
  height: 100vh;
  width: 100%;
}
.swiper {
  height: 100vh;
}
.slide {
  height: 100vh;
  padding: 48rpx 40rpx 200rpx;
  box-sizing: border-box;
}

/* ============ 底部点击翻页导航 ============ */
.report-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 -8rpx 30rpx rgba(224, 67, 104, 0.10);
  z-index: 50;
}
.nav-back {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid rgba(224, 67, 104, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--primary-deep);
  font-weight: 300;
  transition: opacity 0.15s ease;
}
.nav-back.off {
  opacity: 0.25;
}
.nav-progress {
  font-size: 26rpx;
  color: var(--ink-soft);
  font-weight: 700;
}
.nav-cur {
  color: var(--primary-deep);
  font-size: 34rpx;
  font-weight: 900;
}
.nav-next {
  background: linear-gradient(135deg, #ff7a93, #ff5f7e 60%, #f04a70);
  color: #fff;
  border-radius: 999rpx;
  padding: 20rpx 44rpx;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 26rpx rgba(240, 74, 112, 0.35);
  transition: transform 0.12s ease;
}
.nav-next:active {
  transform: scale(0.96);
}
.nav-next.final {
  background: linear-gradient(135deg, #ffb347, #ff8a5c);
  box-shadow: 0 10rpx 26rpx rgba(255, 138, 92, 0.40);
  animation: pulse 2.2s ease-in-out infinite;
}

/* ============ 封面 ============ */
.cover {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 70vh;
  text-align: center;
}
.cover-badge {
  background: linear-gradient(135deg, rgba(255, 95, 126, 0.14), rgba(255, 179, 71, 0.14));
  color: var(--primary-deep);
  border-radius: 999rpx;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 14rpx rgba(224, 67, 104, 0.12);
}
.cover-names {
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1.3;
}
.cover-range {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
}
.cover-ring {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  margin-top: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff, #ffeef2);
  box-shadow: 0 0 0 18rpx rgba(255, 95, 126, 0.10),
    0 24rpx 60rpx rgba(224, 67, 104, 0.22);
  animation: float 3s ease-in-out infinite;
}
.cover-emoji {
  font-size: 110rpx;
}
.cover-hint {
  margin-top: 56rpx;
  font-size: 24rpx;
  color: #c9a6af;
  animation: bounceX 1.8s ease-in-out infinite;
}

/* ============ 通用 ============ */
.slide-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #3d2129;
  margin-bottom: 28rpx;
}
.card.inner {
  margin-bottom: 20rpx;
}
.verdict-line {
  background: #fff;
  border: 2rpx solid rgba(255, 143, 166, 0.16);
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  color: #6b4a55;
  line-height: 1.6;
  box-shadow: 0 8rpx 30rpx rgba(224, 67, 104, 0.07);
  margin-bottom: 16rpx;
  text-align: center;
}

/* ============ 数字总览 ============ */
.big-grid {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.big-cell {
  flex: 1;
  background: #fff;
  border: 2rpx solid rgba(255, 143, 166, 0.16);
  border-radius: 28rpx;
  padding: 36rpx 0;
  text-align: center;
  box-shadow: 0 12rpx 44rpx rgba(224, 67, 104, 0.09);
}
.big-num {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1.1;
}
.big-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}
.ratio-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.ratio-name {
  width: 160rpx;
  font-size: 26rpx;
  font-weight: 700;
}
.ratio-bar {
  flex: 1;
  height: 28rpx;
  background: #f7eef0;
  border-radius: 999rpx;
  overflow: hidden;
}
.ratio-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}
.ratio-fill.me {
  background: linear-gradient(90deg, #ff9a76, #ff5f7e);
}
.ratio-fill.friend {
  background: linear-gradient(90deg, #6fc3ff, #4f8ef7);
}
.ratio-pct {
  width: 90rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--ink);
}

/* ============ 24h 柱状图 ============ */
.chart-bars {
  display: flex;
  align-items: flex-end;
  height: 340rpx;
  gap: 6rpx;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  height: 100%;
}
.bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, #ffc2cf, #ff8fa6);
  position: relative;
  min-height: 8rpx;
  transition: height 0.5s ease;
}
.bar.night {
  background: linear-gradient(180deg, #a48ae0, #7f63c9);
  border-radius: 8rpx 8rpx 0 0;
}
.bar.peak {
  background: linear-gradient(180deg, #ffd75e, #ffb347);
  box-shadow: 0 0 20rpx rgba(255, 179, 71, 0.65);
}
.bar-val {
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: var(--ink-soft);
  white-space: nowrap;
}
.bar-crown {
  position: absolute;
  top: -44rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 30rpx;
}
.bar-label {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: var(--ink-soft);
  min-height: 26rpx;
}
.bar-label.hl {
  color: #e09000;
  font-weight: 800;
}
.chart-legend {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-top: 24rpx;
}
.lg-item {
  font-size: 20rpx;
  color: var(--ink-soft);
  display: flex;
  align-items: center;
}
.lg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  display: inline-block;
}
.lg-dot.day { background: linear-gradient(180deg, #ffc2cf, #ff8fa6); }
.lg-dot.night { background: linear-gradient(180deg, #a48ae0, #7f63c9); }
.lg-dot.peak { background: linear-gradient(180deg, #ffd75e, #ffb347); }

/* ============ 高频词云 ============ */
.word-cloud {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  min-height: 320rpx;
  padding: 36rpx 24rpx;
}
.word {
  font-weight: 700;
  line-height: 1.2;
  display: inline-block;
}

/* ============ 亲密瞬间 ============ */
.moment {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #faf0f2;
}
.moment:last-child {
  border-bottom: none;
}
.moment-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
}
.moment-label {
  font-size: 22rpx;
  color: var(--ink-soft);
}
.moment-text {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #4a2b33;
  font-weight: 600;
}

/* ============ 故事/专属词 ============ */
.story-emoji {
  font-size: 72rpx;
  text-align: center;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}
.story-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #4a2b33;
  text-align: center;
}
.story-line {
  width: 60rpx;
  height: 4rpx;
  background: #f0c4cf;
  border-radius: 4rpx;
  margin: 32rpx auto;
}
.big-word {
  font-size: 88rpx;
  font-weight: 900;
  text-align: center;
  padding: 30rpx 0;
}
.center-card {
  text-align: center;
  padding: 48rpx 32rpx;
}
.topic-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #3d2129;
  margin-top: 8rpx;
}

/* ============ 称号 ============ */
.award-card {
  display: flex;
  align-items: center;
  background: #fff;
  border: 2rpx solid rgba(255, 143, 166, 0.14);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 44rpx rgba(224, 67, 104, 0.09);
}
.award-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 26rpx;
  flex-shrink: 0;
}
.award-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #3d2129;
}
.award-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}

/* ============ 尾声 ============ */
.verdict-card {
  position: relative;
  overflow: hidden;
}
.quote-mark {
  position: absolute;
  top: -14rpx;
  left: 18rpx;
  font-size: 120rpx;
  line-height: 1;
  color: rgba(255, 95, 126, 0.14);
  font-family: Georgia, serif;
}
.verdict-text {
  font-size: 30rpx;
  line-height: 2;
  color: #4a2b33;
  position: relative;
}
.cta-pulse {
  animation: pulse 2.2s ease-in-out infinite;
}
.share-btn {
  margin-top: 20rpx;
  background: #fff;
  color: var(--primary-deep);
  border: 2rpx solid rgba(224, 67, 104, 0.35);
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 2.6;
}
.share-btn::after {
  border: none;
}
.btn-ghost {
  margin-top: 20rpx;
}

/* ============ 海报弹层 ============ */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 10, 20, 0.72);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.poster-img {
  width: 100%;
  border-radius: 20rpx;
  display: block;
}
.poster-actions {
  margin-top: 28rpx;
}
.poster-close {
  text-align: center;
  padding: 20rpx 0 4rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 640px;
  height: 1000px;
}
